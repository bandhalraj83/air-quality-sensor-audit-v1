# Generated / downloaded data -- not committed. Keeps the repo small and
# avoids committing real (possibly large, possibly sensitive) datasets.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Generated reports -- regenerate by re-running each stage. The sample_*
# reports under reports/ ARE committed (see below) as evidence of a working
# run; only the live, regenerable ones are ignored.
reports/data_quality_report.md
reports/alignment_summary.md
reports/training_table_summary.md

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.pytest_cache/

# OS / editor cruft
.DS_Store
.vscode/
.idea/
